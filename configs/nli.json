  "metrics_address": "127.0.0.1:12380",
  "enrichment": {
    "country_db": "/etc/geoip-db/GeoLite2-Country.mmdb",
    "asn_db": "/etc/geoip-db/GeoLite2-ASN.mmdb",
    "city_db": "/etc/geoip-db/GeoLite2-City.mmdb"
  },
  "poll_ms": 500,
  "source_workers": 0,
  "source_batch_lines": 1000,
  "stream_thresholds": {
    "read_lines_per_second": 100000,
    "bytes_per_second": 10485760,
    "quarantined_per_second": 1,
    "queue_depth": 0
  },
  "tail_from_end": false,
  "drain": {
    "sim_th": 0.5,
    "depth": 4,
    "max_children": 100,
    "max_clusters": 10000
  },
  "ai": {
    "enabled": false,
    "provider": "ollama",
    "model": "llama3.2",
    "endpoint": "http://127.0.0.1:11434",
    "api_key_env": "NLI_AI_KEY",
    "max_calls_per_hour": 100,
    "batch_size": 20,
    "min_cluster_size": 10,
    "max_pending_clusters": 1000,
    "max_sample_bytes": 16384
  },
  "replay": {
    "enabled": false,
    "source": "/var/log/nli/quarantine.jsonl"
  }
