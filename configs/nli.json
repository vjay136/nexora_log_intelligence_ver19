{
  "version": 2,
  "inputs": [
    {
      "path": "/var/log/nli/input/auto.log",
      "service": "auto",
      "selection": {
        "mode": "default"
      },
      "multiline": {
        "enabled": true,
        "max_bytes": 2097152,
        "max_lines": 10000,
        "flush_timeout_ms": 4000,
        "rules": [
          "java_exception",
          "python_traceback",
          "go_panic"
        ]
      },
      "mask": {
        "disable_types": []
      }
    },
    {
