{
  "schema_version": "1",
  "descriptor_count": 26,
  "addressable_series_floor": 19000,
  "addressability_explanation": "Each of the 19 client descriptors can address 1,000 observed node_id values. This is dimensional addressability, not a count of live clients or measurements. Stream series also vary by observed source and phase. Only live measurements are exported.",
  "endpoints": {
    "client": {
      "path": "/metrics",
      "format": "Prometheus text 0.0.4",
      "address_config": "/etc/nli/nli.json:metrics_address",
      "default_address": "127.0.0.1:12380",
      "authentication": "None; listener is restricted to a loopback address"
    },
    "controller_catalog": {
      "path": "/api/v1/metrics/catalog",
      "format": "JSON",
      "authentication": "Bearer token with telemetry read permission"
    },
    "controller_samples": {
      "path": "/api/v1/metrics/openmetrics",
      "format": "OpenMetrics 1.0.0",
      "authentication": "Bearer token with telemetry read permission"
    }
  },
  "descriptors": [
    {
      "name": "nli_controller_cpu_cores",
      "group": "controller",
      "type": "gauge",
      "help": "Logical CPUs available to the controller process.",
      "labels": [],
      "unit": "cores",
      "source": "runtime.NumCPU"
    },
    {
      "name": "nli_controller_memory_alloc_bytes",
      "group": "controller",
      "type": "gauge",
      "help": "Bytes allocated and currently in use by the Go heap.",
      "labels": [],
      "unit": "bytes",
      "source": "runtime.MemStats.Alloc"
    },
    {
      "name": "nli_controller_memory_sys_bytes",
      "group": "controller",
      "type": "gauge",
      "help": "Bytes obtained from the operating system by the Go runtime.",
      "labels": [],
      "unit": "bytes",
      "source": "runtime.MemStats.Sys"
    },
    {
      "name": "nli_controller_goroutines",
      "group": "controller",
      "type": "gauge",
      "help": "Current number of Go goroutines.",
      "labels": [],
      "unit": "goroutines",
      "source": "runtime.NumGoroutine"
    },
    {
      "name": "nli_controller_gc_pause_seconds_total",
      "group": "controller",
      "type": "counter",
      "help": "Cumulative garbage collection pause time.",
      "labels": [],
      "unit": "seconds",
      "source": "runtime.MemStats.PauseTotalNs"
    },
    {
      "name": "nli_controller_gc_cycles_total",
      "group": "controller",
      "type": "counter",
      "help": "Completed garbage collection cycles.",
      "labels": [],
      "unit": "cycles",
      "source": "runtime.MemStats.NumGC"
    },
    {
      "name": "nli_controller_uptime_seconds",
      "group": "controller",
      "type": "gauge",
      "help": "Seconds since controller process startup.",
      "labels": [],
      "unit": "seconds",
      "source": "controller startup clock"
    },
